<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EpubFabric_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EpubFabric_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="PDF → EPUB 変換" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 変換するPDFの一覧。ドラッグ＆ドロップで1件ずつ積み上げられる。 -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="FileCountText" Text="変換する PDF（0 件）" VerticalAlignment="Center" />
                <Button x:Name="PickInputButton" Content="追加..." Click="OnPickInputClick" />
                <Button x:Name="RemoveInputButton" Content="選択項目を削除" Click="OnRemoveInputClick" IsEnabled="False" />
                <Button x:Name="ClearInputButton" Content="すべて削除" Click="OnClearInputClick" IsEnabled="False" />
            </StackPanel>

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" MinHeight="120" MaxHeight="200"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="FileList" SelectionMode="Extended" Padding="4"
                          SelectionChanged="OnFileSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ConversionItem">
                            <Grid ColumnSpacing="12" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Location}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="出力フォルダー:" VerticalAlignment="Center" MinWidth="100" />
                <TextBox x:Name="OutputPathBox" Grid.Column="1" IsReadOnly="True"
                         PlaceholderText="未指定なら各 PDF と同じ場所に「入力名.epub」を出力します" />
                <Button x:Name="PickOutputButton" Grid.Column="2" Content="選択..." Click="OnPickOutputClick" />
            </Grid>
        </Grid>

        <!-- オプション。1行に並べるとウィンドウ幅に収まらず右端が隠れるため、
             設定値の入力とチェックボックスを2行に分ける。ウィンドウをさらに狭めても
             操作できるよう、横スクロールを許す。 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ComboBox x:Name="LayoutCombo" Header="レイアウト" SelectedIndex="0" MinWidth="160">
                        <ComboBoxItem Content="固定レイアウト" />
                        <ComboBoxItem Content="リフロー型" />
                    </ComboBox>
                    <NumberBox x:Name="DpiBox" Header="DPI" Value="300" Minimum="72" Maximum="600" SmallChange="50" SpinButtonPlacementMode="Compact" MinWidth="120" />
                    <NumberBox x:Name="MaxPagesBox" Header="ページ数上限（0=全）" Value="0" Minimum="0" SpinButtonPlacementMode="Compact" MinWidth="140" />
                    <ComboBox x:Name="WritingModeCombo" Header="書字方向" SelectedIndex="0" MinWidth="150">
                        <ComboBoxItem Content="自動判定" />
                        <ComboBoxItem Content="横書き（左綴じ）" />
                        <ComboBoxItem Content="縦書き（右綴じ）" />
                    </ComboBox>
                    <TextBox x:Name="OllamaModelBox" Header="Ollama モデル" Text="gemma4:12b" MinWidth="160" IsEnabled="False" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="EnhanceCheck" Content="紙面の高品質化" />
                    <CheckBox x:Name="ForceOcrCheck" Content="常にOCR（テキスト層を無視）" />
                    <CheckBox x:Name="CoverImageCheck" Content="表紙をページ画像で収録（リフロー時）" />
                    <CheckBox x:Name="OllamaCheck" Content="Ollama 分類・校正" Checked="OnOllamaCheckChanged" Unchecked="OnOllamaCheckChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 実行 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ConvertButton" Content="変換開始" Style="{StaticResource AccentButtonStyle}" Click="OnConvertClick" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="キャンセル" Click="OnCancelClick" IsEnabled="False" />
            <Button x:Name="OpenFolderButton" Content="出力フォルダを開く" Click="OnOpenFolderClick" IsEnabled="False" />
            <Button x:Name="EditorButton" Content="校正画面を開く" Click="OnOpenEditorClick" IsEnabled="False" />
        </StackPanel>

        <!-- 進捗 -->
        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar x:Name="ConvertProgressBar" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="StatusText" Text="PDF を選択すると変換を開始できます。" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- ログ -->
        <Border Grid.Row="5" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="LogList" SelectionMode="None" IsItemClickEnabled="False" Padding="8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Padding" Value="4,0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </Grid>
</Page>
