<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpubFabric.Core\EpubFabric.Core.csproj" />
    <ProjectReference Include="..\EpubFabric.Pdf\EpubFabric.Pdf.csproj" />
    <ProjectReference Include="..\EpubFabric.Imaging\EpubFabric.Imaging.csproj" />
    <ProjectReference Include="..\EpubFabric.Layout\EpubFabric.Layout.csproj" />
    <ProjectReference Include="..\EpubFabric.Ocr\EpubFabric.Ocr.csproj" />
    <ProjectReference Include="..\EpubFabric.Ollama\EpubFabric.Ollama.csproj" />
    <ProjectReference Include="..\EpubFabric.Document\EpubFabric.Document.csproj" />
    <ProjectReference Include="..\EpubFabric.Epub\EpubFabric.Epub.csproj" />
    <ProjectReference Include="..\EpubFabric.Evaluation\EpubFabric.Evaluation.csproj" />
    <ProjectReference Include="..\EpubFabric.Persistence\EpubFabric.Persistence.csproj" />
    <ProjectReference Include="..\EpubFabric.Pipeline\EpubFabric.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 本体のGUIが EpubFabric.exe のため、CLIは別名にする（Windowsは大文字小文字を
         区別せず、同名だとPATH上でどちらが起動するか紛らわしいため）。 -->
    <AssemblyName>epubfabric-cli</AssemblyName>
    <!-- GUIと同じアイコンを埋め込む。アイコンの実体はGUI側が実行時にも読むためAssetsに置いている。 -->
    <ApplicationIcon>..\EpubFabric.App\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
